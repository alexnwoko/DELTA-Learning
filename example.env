# Base URL for the application (used for links in emails, etc.)
PUBLIC_URL="https://www.example.com"

# Node environment: "development" or "production"
NODE_ENV="development"

DATABASE_URL="postgresql://user1@localhost/db1?host=/var/run/postgresql/&schema=public"
# DATABASE_URL="postgresql://[db_username]:[db_password]@[db_host]/[db_database_name]"
SESSION_SECRET="not-random-dev-secret" # should be random string for production
# EMAIL_TRANSPORT="file"
EMAIL_FROM='"Example (from example.env file)" <no-reply@example.com>'

# Example SMTP configuration (when EMAIL_TRANSPORT="smtp"), either smtp or file
EMAIL_TRANSPORT="smtp"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587" # 587 is the default value
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"


## REQUIRED CONFIG FOR AZURE B2C SSO
# SSO_AZURE_B2C_TENANT=""
# SSO_AZURE_B2C_CLIENT_ID=""
# SSO_AZURE_B2C_CLIENT_SECRET=""
# SSO_AZURE_B2C_USERFLOW_LOGIN=''
# SSO_AZURE_B2C_USERFLOW_LOGIN_ADMIN_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_LOGIN_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_EDIT=''
# SSO_AZURE_B2C_USERFLOW_EDIT_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_RESET=''
# SSO_AZURE_B2C_USERFLOW_RESET_REDIRECT_URL=""

# default is form, supported values are "form", "sso_azure_b2c", or both separated by comma (e.g. "form,sso_azure_b2c")
AUTHENTICATION_SUPPORTED="form"

# Port for the NestJS REST API HTTP server (default: 3001)
API_PORT=3001

# Set to "false" to skip starting the NestJS HTTP server (default: enabled)
# API_HTTP_SERVER_ENABLED=false

# Network proxy (network has HTTP proxy rule for outbound request, HTTPS doesn't work)
# HTTP_PROXY="URL"

# Support contact shown on the error page. SUPPORT_URL takes precedence over SUPPORT_EMAIL if both are set.
# Use SUPPORT_EMAIL for a mailto link, SUPPORT_URL for a contact page (plain or with query params).
SUPPORT_URL="https://www.undrr.org/contact?topic=delta"
# SUPPORT_EMAIL="support@example.com"


POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_postgres_db

VITE_SERVER_PORT=3000
# Self-hosted basemap (I-3, TR-166). Directory of raster tiles laid out
# z/x/y.png, mounted into the container. Unset: maps draw boundaries only.
# BASEMAP_TILE_DIR=/data/basemap
# Optional: another path on the DELTA origin for the tiles. Other hosts are refused.
# BASEMAP_TILE_URL=/tiles/basemap/{z}/{x}/{y}.png

# Basemap switcher (I-3; Alex 2026-10-16: the reader chooses). Optional layers:
# Self-hosted ESA WorldCover 2021 Sentinel-2 composite, tiles z/x/y.<format>.
# BASEMAP_SATELLITE_TILE_DIR=/data/satellite
# BASEMAP_SATELLITE_FORMAT=jpg
# Google and Mapbox appear only when their key is set (an SEC-20/TR-166
# exception recorded through the PMO). Keys are visible in the browser:
# restrict each by HTTP referrer to this deployment's domain. Never commit keys.
# BASEMAP_GOOGLE_KEY=
# BASEMAP_GOOGLE_REGION=MZ
# BASEMAP_MAPBOX_TOKEN=
# Mapbox's terms require its logo: serve it from this origin and give its path.
# BASEMAP_MAPBOX_LOGO=/assets/mapbox-logo.svg
